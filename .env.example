# Orbital — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# Required: your Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...

# Optional: override the default Express port for local development
PORT=4000

# ── 3D Model Generation (set at least one for AI-generated satellite models) ──
# Tripo3D — fastest, ~$0.10/model (https://platform.tripo3d.ai)
# TRIPO_API_KEY=tsk_...

# Meshy AI — best PBR textures, ~$0.20/model (https://developer.meshy.ai)
# MESHY_API_KEY=msy_...

# Tencent Hunyuan3D — highest detail (https://3d.hunyuan.tencent.com)
# HUNYUAN_API_KEY=...
